<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page_title | escape }}{% unless page_title contains shop.name %} | {{ shop.name | escape }}{% endunless %}</title><meta name="description" content="{{ page_description | escape }}"><link rel="canonical" href="{{ canonical_url }}">{{ content_for_header }}{{ 'style.css' | asset_url | stylesheet_tag }}<script src="{{ 'theme-ui.js' | asset_url }}" defer></script></head><body>{% unless settings.enable_purchase %}<div class="review-bar">DRAFT THEME · Purchases disabled pending approval</div>{% endunless %}{% section 'qm-header' %}<main id="MainContent">{{ content_for_layout }}</main>{% section 'qm-footer' %}</body></html>