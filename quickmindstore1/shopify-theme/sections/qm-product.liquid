{% assign variant = product.selected_or_first_available_variant %}{% assign rental_product = section.settings.rental_product %}{% assign rental_variant = rental_product.selected_or_first_available_variant %}<div class="container section"><div class="breadcrumb"><a href="{{ routes.root_url }}">Home</a> / {{ product.title | escape }}</div><div class="product-grid"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: class: 'product-image', loading: 'eager', alt: product.title }}{% else %}<img class="product-image" src="{{ 'headset.webp' | asset_url }}" alt="QuickMind illustrative setup">{% endif %}<div class="thumbs">{% for image in product.images %}<button type="button" data-gallery-src="{{ image | image_url: width: 1200 }}" aria-label="View product image {{ forloop.index }}">{{ image | image_url: width: 160 | image_tag: loading: 'lazy' }}</button>{% endfor %}</div></div><div class="product-copy"><span class="eyebrow">QUICKMIND HOME</span><h1>{{ product.title | escape }}</h1><div>{{ product.description }}</div><div class="purchase-card">{% form 'product', product, id: 'QuickMindProductForm' %}<div class="form-row"><label for="Variant">Subscription variant</label><select name="id" id="Variant">{% for v in product.variants %}<option value="{{ v.id }}" data-price="{{ v.price | money_with_currency | escape }}" data-available="{{ v.available }}" {% if v.id == variant.id %}selected{% endif %}>{{ v.title | escape }} — {{ v.price | money_with_currency }}{% unless v.available %} — Unavailable{% endunless %}</option>{% endfor %}</select></div><p><b>Subscription product price:</b> <span id="VariantPrice">{{ variant.price | money_with_currency }}</span></p><div class="form-row"><label for="SellingPlan">Annual subscription plan</label><select name="selling_plan" id="SellingPlan" required><option value="">Select an approved annual plan</option>{% for group in product.selling_plan_groups %}{% for plan in group.selling_plans %}<option value="{{ plan.id }}">{{ plan.name | escape }}</option>{% endfor %}{% endfor %}</select></div>{% if rental_product != blank %}<p>Initial equipment rental: {{ rental_variant.price | money_with_currency }} · {{ rental_product.title | escape }}</p><input type="hidden" name="properties[Offer]" value="Equipment rental + annual subscription"><input type="hidden" id="RentalVariant" value="{{ rental_variant.id }}" data-available="{{ rental_variant.available }}">{% else %}<div class="notice">Equipment rental product is not configured. Purchase is disabled.</div>{% endif %}<input type="hidden" name="quantity" value="1"><div id="OfferTotal" class="total-box">Select your annual plan to see its price.</div><label class="confirm-check"><input type="checkbox" id="TermsAccepted" required><span>I have reviewed the approved subscription, rental, cancellation and return terms.</span></label><p class="fine">Equipment is rented. View <a href="{{ shop.terms_of_service.url }}">terms</a>, <a href="{{ shop.refund_policy.url }}">returns</a> and <a href="{{ shop.shipping_policy.url }}">shipping</a> before purchase.</p><button class="btn" type="submit" id="AddBundle" {% unless settings.enable_purchase and rental_product != blank and rental_variant.available and product.selling_plan_groups.size > 0 %}disabled{% endunless %}>Add Plan & Rental to Cart</button><p id="ProductStatus" role="status" aria-live="polite"></p>{% endform %}{% unless settings.enable_purchase %}<div class="notice">Draft theme. Purchases are disabled until launch is approved.</div>{% endunless %}<script type="application/json" id="ProductData">{"variants":[{% for v in product.variants %}{"id":{{ v.id }},"available":{{ v.available | json }},"selling_plan_allocations":[{% for allocation in v.selling_plan_allocations %}{"selling_plan_id":{{ allocation.selling_plan.id }},"price":{{ allocation.price }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}{% unless forloop.last %},{% endunless %}{% endfor %}]}</script><script type="application/json" id="RentalData">{{ rental_variant | json }}</script></div></div></div><div class="buttons"><a class="btn outline" href="/pages/clinical-evidence">Clinical Evidence</a><a class="btn outline" href="/pages/registrations">Registration Documents</a></div>{% for block in section.blocks %}{% render block %}{% endfor %}</div>{% schema %}{"name":"QuickMind product","settings":[{"type":"product","id":"rental_product","label":"Initial equipment rental product"}],"blocks":[{"type":"@app"}],"presets":[{"name":"QuickMind product"}]}{% endschema %}