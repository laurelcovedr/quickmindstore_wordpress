<section class="container section"><h1>Your cart</h1>{% if cart.empty? %}<p>Your cart is empty.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Explore products</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><table><thead><tr><th>Product</th><th>Quantity</th><th>Total</th></tr></thead><tbody>{% for item in cart.items %}<tr><td><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p>{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}</td><td><label for="Quantity-{{ forloop.index }}">Quantity</label><input id="Quantity-{{ forloop.index }}" type="number" min="0" name="updates[]" value="{{ item.quantity }}" style="width:70px"></td><td>{{ item.final_line_price | money_with_currency }}</td></tr>{% endfor %}</tbody></table><h3>Subtotal {{ cart.total_price | money_with_currency }}</h3><p>Tax and shipping calculated at checkout. Review recurring billing and equipment return obligations.</p><button name="update" class="btn outline">Update Cart</button>{% if settings.enable_purchase %}<button name="checkout" type="submit" class="btn">Checkout</button>{% else %}<p class="notice">Checkout disabled in this draft.</p>{% endif %}</form>{% endif %}</section>{% schema %}{"name":"QuickMind cart","settings":[]}{% endschema %}