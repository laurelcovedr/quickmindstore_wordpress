<section class="container section"><h1>{{ collection.title | escape }}</h1><div class="cards">{% paginate collection.products by 12 %}{% for product in collection.products %}<article class="plan"><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>{% if product.featured_image %}{{ product.featured_image | image_url: width: 500 | image_tag: class: 'product-image', loading: 'lazy' }}{% endif %}<p>{{ product.price | money_with_currency }}</p><a class="btn" href="{{ product.url }}">View Product</a></article>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}</div></section>{% schema %}{"name":"Collection","settings":[]}{% endschema %}