<header><a href="{{ routes.root_url }}" class="brand">Quick<span>Mind</span><small>BY YIWEI MEDICAL</small></a><nav aria-label="Main navigation"><a href="{{ routes.root_url }}">Home</a><a href="/pages/pricing">Home Plans</a><a href="{{ settings.home_product.url | default: routes.all_products_collection_url }}">Home Product</a><a href="/pages/clinical-evidence">Evidence</a><a href="/pages/registrations">Registrations</a></nav><div class="utilities"><a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a><button class="menu-toggle" aria-expanded="false">Menu</button></div></header>{% if localization.available_countries.size > 1 %}<div class="region-message">{% form 'localization' %}<label for="CountrySelector">Shipping country</label><select id="CountrySelector" name="country_code">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} · {{ country.currency.iso_code }}</option>{% endfor %}</select><button type="submit">Update country</button>{% endform %}</div>{% endif %}{% schema %}{"name":"QuickMind header","settings":[]}{% endschema %}